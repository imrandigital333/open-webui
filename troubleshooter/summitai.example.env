# SummitAI (Symphony SUMMIT) ITSM integration — copy the values you need into
# the service environment (systemd unit, /etc/environment, or the shell that
# starts uvicorn). Leave ALL of these unset to run the Incidents/Changes
# dashboard on built-in DEMO data.

# Base REST URL of your SummitAI API (no trailing slash)
SUMMITAI_BASE_URL=https://summit.bial.internal/api/v1

# Bearer token / API key issued for a read service account
SUMMITAI_TOKEN=replace-with-token

# --- optional overrides (sensible defaults shown) ---
# Header that carries the token, and the value prefix:
#SUMMITAI_AUTH_HEADER=Authorization
#SUMMITAI_AUTH_PREFIX=Bearer 
# Paths appended to BASE_URL for each resource:
#SUMMITAI_INCIDENTS_PATH=/incidents
#SUMMITAI_CHANGES_PATH=/changes
# Set to 0 only if the endpoint uses an internal/self-signed cert:
#SUMMITAI_VERIFY_TLS=1
