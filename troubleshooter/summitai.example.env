# SummitAI (Symphony SUMMIT) ITSM integration.
# PREFERRED: configure everything from the UI — Settings -> "SummitAI (ITSM)
# integration" (stores itsm.yaml, chmod 600, with a Test connection button).
# These environment variables remain as a fallback for env-based deployments.

# API style: summit_wcf (the .svc envelope endpoint, default) or rest
#SUMMITAI_API_STYLE=summit_wcf

# The service URL, e.g. the Chatbot proxy WCF endpoint:
#SUMMITAI_BASE_URL=https://10.11.1.105/Chatbotproxy/REST/Summit_RESTWCF.svc
# API key (sent as _ProxyDetails.APIKey with AuthType APIKEY):
#SUMMITAI_TOKEN=replace-with-api-key
# Self-signed / IP endpoint? disable cert verification:
#SUMMITAI_VERIFY_TLS=0

# --- summit_wcf options ---
# JSON envelope operation appended to the .svc URL (the bare .svc address is
# the SOAP endpoint and answers JSON POSTs with HTTP 415):
#SUMMITAI_WCF_OPERATION=RESTService/CommonWS_JsonObjCall
#SUMMITAI_ORG_ID=1
#SUMMITAI_PROXY_ID=0
# ServiceNames vary per deployment — confirm with your Summit admin:
#SUMMITAI_INCIDENTS_SERVICE=IM_FetchIncidents
#SUMMITAI_DETAIL_SERVICE=IM_GetIncidentDetails
#SUMMITAI_CHANGES_SERVICE=CM_FetchChanges

# --- rest style options (only if SUMMITAI_API_STYLE=rest) ---
#SUMMITAI_AUTH_HEADER=Authorization
#SUMMITAI_AUTH_PREFIX=Bearer 
#SUMMITAI_INCIDENTS_PATH=/incidents
#SUMMITAI_CHANGES_PATH=/changes
