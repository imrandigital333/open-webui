[Unit]
Description=AI Troubleshooter (Claude Code agentic troubleshooting UI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Dedicated service account that (a) is logged in to Claude Code and
# (b) holds the read-only SSH keys for the inventory hosts.
User=aitrouble
Group=aitrouble
WorkingDirectory=/opt/ai-troubleshooter/troubleshooter
Environment=TROUBLESHOOTER_INVENTORY=/opt/ai-troubleshooter/inventory.yaml
Environment=TROUBLESHOOTER_DATA=/opt/ai-troubleshooter/data/sessions
Environment=TROUBLESHOOTER_HOST=0.0.0.0
Environment=TROUBLESHOOTER_PORT=8090
# Optional: pin a model instead of the Claude Code default
# Environment=TROUBLESHOOTER_MODEL=claude-opus-4-8
# HTTPS/TLS — set both to serve HTTPS directly (the cert/key must be readable
# by the User= account above; /root/.ssl paths require User=root).
# Environment=TROUBLESHOOTER_SSL_CERTFILE=/root/.ssl/streamlit/streamlit-bundle.pem
# Environment=TROUBLESHOOTER_SSL_KEYFILE=/root/.ssl/streamlit/streamlit.key
# Environment=TROUBLESHOOTER_SSL_KEY_PASSWORD=   # only if the key is encrypted
ExecStart=/opt/ai-troubleshooter/venv/bin/python -m app
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
